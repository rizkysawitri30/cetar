<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IngatKetik — Mastery Learning Informatika</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Google Fonts: Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    .material-rich-editor p, .learning-material p { margin: 0 0 .85rem; }
    .material-rich-editor ul, .learning-material ul { list-style: disc; padding-left: 1.75rem; margin: .6rem 0 1rem; }
    .material-rich-editor ol, .learning-material ol { list-style: decimal; padding-left: 1.75rem; margin: .6rem 0 1rem; }
    .material-rich-editor li, .learning-material li { margin: .3rem 0; }
    .material-rich-editor div, .learning-material div { margin-bottom: .5rem; }
    body {
      font-family: 'Inter', sans-serif;
    }

    /* ===== Modern Grid UI — visual-only enhancement ===== */
    :root {
      --ui-ink: #172554;
      --ui-blue: #2563eb;
      --ui-violet: #7c3aed;
      --ui-cyan: #06b6d4;
      --ui-glass: rgba(255,255,255,.88);
    }
    html { scroll-behavior: smooth; }
    body {
      background-color: #f7f9ff !important;
      background-image:
        linear-gradient(rgba(99,102,241,.075) 1px, transparent 1px),
        linear-gradient(90deg, rgba(99,102,241,.075) 1px, transparent 1px),
        radial-gradient(circle at 12% 8%, rgba(34,211,238,.14), transparent 26rem),
        radial-gradient(circle at 88% 22%, rgba(167,139,250,.16), transparent 28rem) !important;
      background-size: 28px 28px, 28px 28px, auto, auto;
      background-attachment: fixed;
    }
    header {
      background: rgba(255,255,255,.86) !important;
      border-color: rgba(148,163,184,.28) !important;
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      box-shadow: 0 8px 30px rgba(30,41,59,.045);
    }
    footer { background: rgba(255,255,255,.8) !important; backdrop-filter: blur(12px); }
    #app-container { animation: pageEnter .48s cubic-bezier(.2,.75,.25,1) both; }
    @keyframes pageEnter {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    #app-container .rounded-2xl, #app-container .rounded-xl {
      transition: box-shadow .25s ease, border-color .25s ease, transform .25s ease;
    }
    #app-container .bg-white.rounded-2xl,
    #app-container .bg-white.rounded-xl,
    #app-container section.rounded-2xl {
      box-shadow: 0 12px 35px rgba(30,41,59,.055);
    }
    #app-container .grid > div:hover {
      border-color: rgba(99,102,241,.35);
    }
    button {
      position: relative;
      overflow: hidden;
      transition: transform .2s ease, box-shadow .2s ease, filter .2s ease !important;
    }
    button:not(:disabled):hover {
      transform: translateY(-2px);
      filter: saturate(1.08);
      box-shadow: 0 8px 20px rgba(37,99,235,.14);
    }
    button:not(:disabled):active { transform: translateY(0) scale(.98); }
    button:disabled { cursor: not-allowed; }
    button .btn-icon {
      width: 1rem; height: 1rem; flex: 0 0 auto;
      display: inline-block; vertical-align: middle;
    }
    button:has(.btn-icon) { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
    input, textarea, select {
      transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }
    input:focus, textarea:focus, select:focus {
      box-shadow: 0 0 0 4px rgba(99,102,241,.12) !important;
    }
    .sim-item { transition: transform .25s ease, box-shadow .25s ease; }
    .sim-item:hover { box-shadow: 0 5px 14px rgba(79,70,229,.12); }
    @keyframes gentleFloat { 0%,100% { transform: translateY(0) } 50% { transform: translateY(-5px) } }
    header [data-lucide="book-marked"] { animation: gentleFloat 3.2s ease-in-out infinite; }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: .01ms !important; }
    }


    /* Warna berbeda untuk setiap kartu, konsisten di semua tampilan */
    #app-container .grid > div.rounded-2xl:nth-child(8n+1) { background:linear-gradient(145deg,#eff6ff,#dbeafe);border-color:#93c5fd; }
    #app-container .grid > div.rounded-2xl:nth-child(8n+2) { background:linear-gradient(145deg,#faf5ff,#ede9fe);border-color:#c4b5fd; }
    #app-container .grid > div.rounded-2xl:nth-child(8n+3) { background:linear-gradient(145deg,#ecfdf5,#d1fae5);border-color:#6ee7b7; }
    #app-container .grid > div.rounded-2xl:nth-child(8n+4) { background:linear-gradient(145deg,#fff7ed,#ffedd5);border-color:#fdba74; }
    #app-container .grid > div.rounded-2xl:nth-child(8n+5) { background:linear-gradient(145deg,#fff1f2,#ffe4e6);border-color:#fda4af; }
    #app-container .grid > div.rounded-2xl:nth-child(8n+6) { background:linear-gradient(145deg,#ecfeff,#cffafe);border-color:#67e8f9; }
    #app-container .grid > div.rounded-2xl:nth-child(8n+7) { background:linear-gradient(145deg,#fefce8,#fef9c3);border-color:#fde047; }
    #app-container .grid > div.rounded-2xl:nth-child(8n+8) { background:linear-gradient(145deg,#fdf2f8,#fce7f3);border-color:#f9a8d4; }
    #app-container .grid > div.rounded-2xl {border-width:1px;}
    #app-container .grid > div.rounded-2xl:hover {transform:translateY(-3px);box-shadow:0 14px 30px rgba(30,41,59,.12);}
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

  <!-- ========================================== -->
  <!-- 1. NAVIGATION BAR                          -->
  <!-- ========================================== -->
  <header className="bg-white border-b border-slate-200 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3 cursor-pointer" onclick="navigateTo('home')">
        <div class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white p-2.5 rounded-xl shadow-md">
          <i data-lucide="book-marked" class="w-6 h-6"></i>
        </div>
        <div>
          <span class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-indigo-600">
            CETAR!
          </span>
          <span class="hidden sm:inline-block text-xs text-slate-500 ml-2 border-l pl-2 border-slate-300">
            Retrieval Practice • Generative Learning • Formative Feedback • Mastery Learning
          </span>
        </div>
      </div>

      <!-- Auth Controls Dynamic Render -->
      <div id="nav-actions" class="flex items-center space-x-3">
        <!-- Rendered via JS -->
      </div>
    </div>
  </header>

  <!-- MAIN CONTAINER FOR VIEWS -->
  <main id="app-container" class="flex-1 flex flex-col">
    <!-- Dynamic views will be rendered here -->
  </main>

  <!-- FOOTER -->
  <footer class="bg-white border-t border-slate-200 py-6 text-center text-xs text-slate-500 mt-auto">
    © 2026 CETAR — Platform Retrieval Practice, Generative Learning, Formative Feedback, dan Mastery Learning Informatika.
  </footer>

  <!-- ========================================== -->
  <!-- JAVASCRIPT LOGIC & STATE MANAGEMENT        -->
  <!-- ========================================== -->
  <script>

    // Ganti dengan URL deployment Web App Google Apps Script (/exec).
    const API_URL = 'https://script.google.com/macros/s/AKfycbwNZWC-WD3g7o3p9JhJGgg0RICzyYyutyzIRlPsDYGvO4Kz9hIW4TGOll3fFbD2H3QIkQ/exec';
    let sessionToken = '';
    let remoteReady = false;
    async function api(action, data = {}) {
      if (!/^https:\/\/script\.google\.com\/macros\/s\//.test(API_URL)) throw Error('Isi API_URL dengan URL deployment Google Apps Script terlebih dahulu.');
      const response = await fetch(API_URL, {method:'POST', headers:{'Content-Type':'text/plain;charset=utf-8'}, body:JSON.stringify({action,token:sessionToken,...data}),redirect:'follow'});
      if (!response.ok) throw Error('HTTP '+response.status);
      const result = await response.json();
      if (!result.ok) throw Error(result.error || 'Permintaan gagal');
      return result.data;
    }
    function updateStudentProgress() {
      if (!currentUser || currentUser.role !== 'student') return;
      const passed = new Set(submissions.filter(x=>x.studentId===currentUser.id && x.passed).map(x=>Number(x.levelId)));
      levels = levels.map((l,i)=>({...l,status:passed.has(Number(l.id))?'completed':(i===0 || passed.has(Number(levels[i-1]?.id)))?'available':'locked'}));
      currentUser.progress=Math.round(passed.size/Math.max(1,levels.length)*100);
      currentUser.attemptsCount=submissions.filter(x=>x.studentId===currentUser.id).length;
    }
    async function handleTokenLogin(event) {
      event.preventDefault();
      const form=event.currentTarget;
      const token=form.querySelector('[name="token"]').value.trim().toUpperCase().replace(/\s+/g,'');
      const btn=form.querySelector('button[type="submit"]');
      btn.disabled=true; btn.textContent='Memverifikasi token...';
      try {
        sessionToken=token;
        const data=await api('login');
        currentUser=data.user;
        levels=data.levels;
        submissions=data.submissions;
        students=data.students;
        remoteReady=true;
        if(currentUser.role==='student') updateStudentProgress();
        navigateTo(currentUser.role==='teacher'?'teacher-dash':'student-dash');
      } catch(err) {sessionToken='';showModalAlert('Login gagal: '+escapeHTML(err.message));}
      finally {btn.disabled=false;btn.textContent='Masuk dengan Token';}
    }
    async function refreshFromDatabase() {
      if(!remoteReady)return;
      try {
        const data=await api('sync');
        levels=data.levels;submissions=data.submissions;students=data.students;
        if(currentUser?.role==='student')updateStudentProgress();
        renderView();
      }catch(e){console.error('Sinkronisasi gagal:',e);}
    }
    async function saveLevelsRemote() {
      if(!remoteReady)return;
      try {await api('saveLevels',{levels});}
      catch(e){showModalAlert('Gagal menyimpan soal ke Spreadsheet: '+escapeHTML(e.message));}
    }
    async function saveSubmissionRemote(record) {
      if(!remoteReady)return;
      try {await api('submit',{submission:record});}
      catch(e){showModalAlert('Jawaban belum tersimpan di Spreadsheet: '+escapeHTML(e.message));}
    }

    // ------------------------------------------
    // MOCK DATA & APP STATE
    // ------------------------------------------
    let currentRoute = 'home'; // 'home', 'login-student', 'login-teacher', 'student-dash', 'teacher-dash'
    let currentUser = null;    // { role: 'student'|'teacher', name: '...', id: '...' }

    const INITIAL_LEVELS = [
      {
        id: 1,
        title: "Level 1 — Pengertian Struktur Data",
        objective: "Siswa mampu menjelaskan definisi struktur data dan fungsinya dengan kata-katanya sendiri.",
        durationMinutes: 5,
        remediationDurationMinutes: 3,
        status: "available", // 'locked', 'available', 'completed'
        textMaterial: "Struktur data adalah cara menyimpan, mengorganisasi, dan mengatur data di dalam komputer agar dapat digunakan secara efisien. Dengan struktur data yang tepat, program dapat melakukan pencarian, penambahan, dan penghapusan data dengan lebih cepat. Contoh fungsi utamanya meliputi efisiensi memori, kemudahan pengelolaan data skala besar, dan penataan logika program.",
        audioTranscript: "Struktur data adalah metode penyimpanan dan pengorganisasian data pada sistem komputer. Tujuannya adalah efisiensi pengolahan data.",
        videoUrl: "https://www.youtube.com/embed/dQw4w9WgXcQ",
        question: "Apa yang dimaksud dengan struktur data? Jelaskan menggunakan bahasamu sendiri dan sebutkan fungsi utamanya!",
        criteria: {
          mandatoryConcepts: ["menyimpan", "mengorganisasi", "komputer", "efisien"],
          synonyms: {
            "menyimpan": ["menampung", "menaruh", "memuat"],
            "mengorganisasi": ["mengatur", "menata", "mengelola", "mengelompokkan"],
            "efisien": ["cepat", "hemat memori", "optimal"]
          },
          minScore: 75,
          rubricHint: "Jawaban harus mencakup esensi pengorganisasian data dan manfaat efisiensinya."
        },
        remediationMaterial: "Ingat kembali: Struktur data BUKAN sekadar data biasa, melainkan CARA MENATA data di memori komputer agar algoritma bisa bekerja efisien dan cepat."
      },
      {
        id: 2,
        title: "Level 2 — Jenis Struktur Data",
        objective: "Siswa mampu membedakan struktur data linear seperti Array, Linked List, Stack, dan Queue.",
        durationMinutes: 5,
        remediationDurationMinutes: 3,
        status: "locked",
        textMaterial: "Struktur data terbagi menjadi linear dan non-linear. Contoh struktur data linear:\n1. Array: Elemen disimpan berurutan dengan indeks.\n2. Stack (Tumpukan): Menerapkan prinsip LIFO (Last In First Out), seperti tumpukan piring.\n3. Queue (Antrean): Menerapkan prinsip FIFO (First In First Out), seperti antrean kasir.",
        audioTranscript: "Stack menerapkan prinsip LIFO, sedangkan Queue menerapkan prinsip FIFO.",
        videoUrl: "https://www.youtube.com/embed/dQw4w9WgXcQ",
        question: "Bandingkan perbedaan utama antara Stack dan Queue beserta prinsip kerja masing-masing!",
        criteria: {
          mandatoryConcepts: ["stack", "queue", "lifo", "fifo"],
          synonyms: {
            "lifo": ["last in first out", "terakhir masuk pertama keluar"],
            "fifo": ["first in first out", "pertama masuk pertama keluar"]
          },
          minScore: 80,
          rubricHint: "Harus menyebutkan LIFO untuk Stack dan FIFO untuk Queue."
        },
        remediationMaterial: "Stack seperti tumpukan buku (LIFO). Queue seperti antrean tiket (FIFO)."
      },
      {
        id: 3,
        title: "Level 3 — Cara Kerja Operasi Data",
        objective: "Siswa mampu memprediksi hasil operasi Push/Pop pada Stack dan Enqueue/Dequeue pada Queue.",
        durationMinutes: 6,
        remediationDurationMinutes: 3,
        status: "locked",
        textMaterial: "Operasi dasar Stack: Push (menambah data ke atas) dan Pop (mengambil data teratas). Operasi Queue: Enqueue (masuk dari belakang) dan Dequeue (keluar dari depan). Contoh: Jika kita Push(A), Push(B), lalu Pop(), maka yang keluar adalah B.",
        audioTranscript: "Push memasukkan data ke Stack, Pop mengambil data teratas.",
        videoUrl: "https://www.youtube.com/embed/dQw4w9WgXcQ",
        question: "Jika dilakukan operasi Push(X), Push(Y), Push(Z) lalu Pop() dua kali pada Stack kosong, elemen apa yang tersisa di Stack?",
        criteria: {
          mandatoryConcepts: ["x", "tersisa"],
          synonyms: {},
          minScore: 80,
          rubricHint: "Jawaban benar adalah X."
        },
        remediationMaterial: "Push X, Y, Z -> Stack: [X, Y, Z]. Pop 1 kali mengeluarkan Z. Pop 2 kali mengeluarkan Y. Sisa: X."
      },
      {
        id: 4,
        title: "Level 4 — Penerapan Struktur Data",
        objective: "Siswa mampu memilih struktur data yang tepat untuk kasus nyata.",
        durationMinutes: 5,
        remediationDurationMinutes: 3,
        status: "locked",
        textMaterial: "Pemilihan struktur data menentukan kinerja aplikasi. Fitur 'Undo' pada text editor menggunakan Stack. Sistem cetak printer menggunakan Queue. Pencarian rute Google Maps menggunakan Graph.",
        audioTranscript: "Undo menggunakan Stack karena membatalkan tindakan terakhir.",
        videoUrl: "https://www.youtube.com/embed/dQw4w9WgXcQ",
        question: "Struktur data apa yang paling cocok untuk membuat fitur 'Undo/Redo' pada aplikasi edit teks? Berikan alasannya!",
        criteria: {
          mandatoryConcepts: ["stack", "lifo", "terakhir"],
          synonyms: { "stack": ["tumpukan"] },
          minScore: 80,
          rubricHint: "Menyebutkan Stack karena riwayat tindakan terakhir harus dibatalkan terlebih dahulu."
        },
        remediationMaterial: "Tindakan paling baru adalah yang pertama kali dibatalkan saat menekan Undo. Ini sesuai prinsip LIFO pada Stack."
      }
    ];

    // Data disimpan di browser agar perubahan soal dan jawaban tetap ada setelah halaman dimuat ulang.
    const STORAGE_LEVELS = 'ingatketik_levels_v2';
    const STORAGE_SUBMISSIONS = 'ingatketik_submissions_v2';
    let levels = (() => {
      try { const saved = JSON.parse(localStorage.getItem(STORAGE_LEVELS)); return Array.isArray(saved) && saved.length ? saved : [...INITIAL_LEVELS]; }
      catch (_) { return [...INITIAL_LEVELS]; }
    })();
    let submissions = (() => {
      try { const saved = JSON.parse(localStorage.getItem(STORAGE_SUBMISSIONS)); return Array.isArray(saved) ? saved : []; }
      catch (_) { return []; }
    })();
    function persistLevels() { saveLevelsRemote(); }
    function persistSubmissions() { const latest=submissions[submissions.length-1]; if(latest)saveSubmissionRemote(latest); }
    let students = [
      { id: "S001", name: "Andi Pratama", class: "X RPL 1", progress: 25, currentLevel: 1, attemptsCount: 3 },
      { id: "S002", name: "Siti Rahma", class: "X RPL 1", progress: 75, currentLevel: 3, attemptsCount: 5 },
      { id: "S003", name: "Budi Santoso", class: "X RPL 2", progress: 0, currentLevel: 1, attemptsCount: 0 }
    ];

    // Session State
    let activeLevel = null;
    let learningStage = 1; // 1: Select Format, 2: Studying, 3: Answering, 4: Remediation
    let selectedFormat = 'text';
    let timerInterval = null;
    let timeLeft = 0;
    let answerInputText = '';
    let isEvaluating = false;
    let evalResult = null;
    let attemptCountForLevel = 0;

    // Speech Recognition
    let recognition = null;
    let isListening = false;
    let speechBaseText = '';

    // ------------------------------------------
    // SPEECH RECOGNITION INITIALIZATION
    // ------------------------------------------
    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      recognition = new SpeechRecognition();
      recognition.continuous = true;
      recognition.interimResults = true;
      recognition.lang = 'id-ID';

      recognition.onresult = (event) => {
        // Bangun ulang seluruh hasil dari sesi ini; interim tidak boleh ditambahkan berulang.
        const transcript = Array.from(event.results).map(r => r[0].transcript.trim()).filter(Boolean).join(' ');
        const inputElem = document.getElementById('answer-textarea');
        if (inputElem) {
          answerInputText = [speechBaseText, transcript].filter(Boolean).join(' ').trim();
          inputElem.value = answerInputText;
          updateCharCount();
        }
      };

      recognition.onerror = (event) => {
        console.error("Speech error:", event.error);
        isListening = false;
        updateSpeechBtnUI();
      };

      recognition.onend = () => {
        isListening = false;
        updateSpeechBtnUI();
      };
    }

    function toggleSpeechRecognition() {
      if (!recognition) {
        showModalAlert("Browser Anda tidak mendukung fitur Pengenal Suara (Speech-to-Text). Gunakan Chrome!");
        return;
      }
      if (isListening) {
        recognition.stop();
        isListening = false;
      } else {
        try {
          speechBaseText = document.getElementById('answer-textarea')?.value.trim() || answerInputText.trim();
          recognition.start();
          isListening = true;
        } catch (e) {
          console.error(e);
        }
      }
      updateSpeechBtnUI();
    }

    function updateSpeechBtnUI() {
      const btn = document.getElementById('speech-btn');
      if (btn) {
        if (isListening) {
          btn.className = "px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 bg-rose-500 text-white animate-pulse";
          btn.innerHTML = `<i data-lucide="mic-off" class="w-3.5 h-3.5"></i> <span>Merekam... (Klik Berhenti)</span>`;
        } else {
          btn.className = "px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 bg-slate-200 text-slate-700 hover:bg-slate-300 transition";
          btn.innerHTML = `<i data-lucide="mic" class="w-3.5 h-3.5"></i> <span>Input Suara (Speech-to-Text)</span>`;
        }
        lucide.createIcons();
      }
    }

    // Speech Synthesis
    function speakText(text) {
      // Narasi mengikuti materi teks lengkap, termasuk bagian-bagian dan urutannya.
      text = String(text || "").replace(/\n+/g, ". ").replace(/\s+/g, " ").trim();
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'id-ID';
        utterance.rate = 0.92;
        window.speechSynthesis.speak(utterance);
      } else {
        showModalAlert("Fitur pemutar suara tidak didukung browser ini.");
      }
    }

    // Custom Modal Alert (Replaces alert)
    function showModalAlert(message) {
      const modal = document.createElement('div');
      modal.className = "fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 animate-fade-in";
      modal.innerHTML = `
        <div class="bg-white rounded-2xl p-6 max-w-sm w-full text-center shadow-xl">
          <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-4">
            <i data-lucide="info" class="w-6 h-6"></i>
          </div>
          <p class="text-sm font-medium text-slate-800 mb-6">${message}</p>
          <button onclick="this.closest('.fixed').remove()" class="w-full py-2.5 bg-blue-600 text-white text-xs font-semibold rounded-xl hover:bg-blue-700">Tutup</button>
        </div>
      `;
      document.body.appendChild(modal);
      lucide.createIcons();
    }

    // ------------------------------------------
    // TIMER UTILITIES
    // ------------------------------------------
    function startTimer(seconds, onExpire) {
      clearInterval(timerInterval);
      timeLeft = seconds;
      updateTimerDisplay();

      timerInterval = setInterval(() => {
        timeLeft--;
        updateTimerDisplay();
        if (timeLeft <= 0) {
          clearInterval(timerInterval);
          if (onExpire) onExpire();
        }
      }, 1000);
    }

    function stopTimer() {
      clearInterval(timerInterval);
    }

    function formatTime(seconds) {
      const m = Math.floor(seconds / 60);
      const s = seconds % 60;
      return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
    }

    function updateTimerDisplay() {
      const elem = document.getElementById('timer-display');
      if (elem) {
        elem.innerText = formatTime(timeLeft);
      }
    }

    // ------------------------------------------
    // ROUTING & CONTROLLERS
    // ------------------------------------------
    function navigateTo(route) {
      currentRoute = route;
      renderNav();
      renderView();
    }

    function handleStudentLogin(e) { return handleTokenLogin(e); }
    function handleTeacherLogin(e) { return handleTokenLogin(e); }

    function logout() {
      currentUser = null;
