    // Editor materi: format daftar dan perataan paragraf, disimpan sebagai HTML aman.
    function materialHTML(value) {
      const raw = String(value || '');
      if (!/<\/?(?:p|div|ul|ol|li|br)\b/i.test(raw)) return raw.split('\n').map(x => '<p>' + escapeHTML(x) + '</p>').join('');
      const doc = new DOMParser().parseFromString(raw, 'text/html');
      const allowed = new Set(['P','DIV','BR','UL','OL','LI','B','STRONG','I','EM','U']);
      function clean(node) {
        if (node.nodeType === Node.TEXT_NODE) return escapeHTML(node.textContent);
        if (node.nodeType !== Node.ELEMENT_NODE) return '';
        const children = Array.from(node.childNodes).map(clean).join('');
        if (!allowed.has(node.tagName)) return children;
        const tag = node.tagName.toLowerCase();
        if (tag === 'br') return '<br>';
        const align = (node.style.textAlign || node.getAttribute('align') || '').toLowerCase();
        const style = ['left','right','center','justify'].includes(align) ? ' style="text-align:' + align + '"' : '';
        return '<' + tag + style + '>' + children + '</' + tag + '>';
      }
      return Array.from(doc.body.childNodes).map(clean).join('');
    }
