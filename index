                    <div class="flex flex-wrap gap-2 shrink-0">
                      <button type="button" onclick="editQuestion(${Number(lvl.id)})" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-indigo-200 bg-white text-indigo-700 hover:bg-indigo-50 text-xs font-semibold" aria-label="Edit soal ${escapeHTML(lvl.title)}">
                        <i data-lucide="pencil" class="w-3.5 h-3.5"></i> Edit
                      </button>
                      <button type="button" onclick="deleteQuestion(${Number(lvl.id)})" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-rose-200 bg-white text-rose-700 hover:bg-rose-50 text-xs font-semibold" aria-label="Hapus soal ${escapeHTML(lvl.title)}">
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Hapus
                      </button>
                    </div>
                  </div>
                  <p class="text-xs text-slate-600 mb-3 whitespace-pre-wrap">${escapeHTML(lvl.question || '')}</p>
                  <div class="flex flex-wrap gap-2 text-xs">
                    <span class="font-semibold text-slate-700">Konsep Wajib:</span>
                    ${(lvl.criteria?.mandatoryConcepts || []).map(c => `<span class="bg-indigo-100 text-indigo-800 px-2 py-0.5 rounded">${escapeHTML(c)}</span>`).join('')}
                  </div>
                </div>
              `).join('')}
            </div>
          </div>
`:''}
      </div>`;
    }


    // Initialize application navigation on load
    window.onload = () => {
      renderNav();
      renderView();
    };
  </script>

<script>
/* Visual-only button icon enhancement: labels and functionality remain unchanged. */
(function () {
  const rules = [
    [/masuk|login|mulai belajar/i, 'log-in'],
    [/keluar|logout/i, 'log-out'],
    [/kembali/i, 'arrow-left'],
    [/kirim jawaban|submit|evaluasi/i, 'send'],
    [/mulai level|mulai/i, 'play'],
    [/pelajari ulang/i, 'rotate-ccw'],
    [/terkunci/i, 'lock'],
    [/buat array/i, 'layers'],
    [/isi indeks|enqueue|push/i, 'plus-circle'],
    [/edit data|ubah/i, 'pencil'],
    [/hapus data|dequeue|pop/i, 'trash-2'],
    [/reset/i, 'rotate-ccw'],
    [/putar narasi|dengarkan materi/i, 'volume-2'],
    [/berhenti/i, 'square'],
    [/input suara|merekam/i, 'mic'],
    [/saya sudah paham|lanjut menjawab/i, 'arrow-right-circle'],
    [/tutup/i, 'x'],
    [/sinkron|refresh/i, 'refresh-cw'],
    [/simpan/i, 'save'],
    [/tambah|buat|tambahkan/i, 'plus'],
    [/hapus|delete/i, 'trash-2'],
    [/edit|ubah/i, 'pencil'],
    [/cari|search/i, 'search'],
    [/lihat|detail/i, 'eye'],
    [/tambah level|level/i, 'layers'],
    [/guru/i, 'graduation-cap'],
    [/murid|siswa/i, 'user-round'],
    [/lanjut|berikutnya/i, 'arrow-right'],
    [/kirim|submit/i, 'send']
  ];
  function decorateButtons(root) {
    if (!root || !root.querySelectorAll) return;
    root.querySelectorAll('button').forEach(btn => {
      if (btn.querySelector('.btn-icon') || btn.querySelector('svg, i[data-lucide]')) return;
      const label = (btn.innerText || btn.getAttribute('aria-label') || btn.title || '').trim();
      if (!label) return;
      const match = rules.find(([pattern]) => pattern.test(label));
      if (!match) return;
      const icon = document.createElement('i');
      icon.setAttribute('data-lucide', match[1]);
      icon.className = 'btn-icon';
      icon.setAttribute('aria-hidden', 'true');
      btn.insertBefore(icon, btn.firstChild);
    });
    if (window.lucide && typeof window.lucide.createIcons === 'function') {
      window.lucide.createIcons();
    }
  }
  let scheduled = false;
  const observer = new MutationObserver(() => {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(() => {
      scheduled = false;
      decorateButtons(document);
    });
  });
  document.addEventListener('DOMContentLoaded', () => {
    decorateButtons(document);
    observer.observe(document.body, { childList: true, subtree: true });
  });
})();
</script>

