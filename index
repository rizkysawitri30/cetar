    // Concept Evaluation Logic
    async function submitAnswer() {
      if (learningStage !== 3 || isEvaluating) return;
      isEvaluating = true;
      if (isListening && recognition) { recognition.stop(); isListening = false; updateSpeechBtnUI(); }
      if (!answerInputText.trim()) {
        isEvaluating = false;
        showModalAlert("Silakan ketik atau rekam jawaban Anda terlebih dahulu.");
        return;
      }

      const submitBtn = document.getElementById('submit-btn');
      if (submitBtn) {
        submitBtn.innerText = "Memeriksa Konsep...";
        submitBtn.disabled = true;
      }

      // Beri browser kesempatan menampilkan status tombol sebelum memproses.
      await new Promise(resolve => setTimeout(resolve, 0));
      try {
      const normalizeConcept = (value) => String(value ?? '').toLowerCase().normalize('NFKC')
        .replace(/[^\p{L}\p{N}]+/gu, ' ').trim().replace(/\s+/g, ' ');
      const userText = ' ' + normalizeConcept(answerInputText) + ' ';
      const criteria = activeLevel.criteria || {};
      let matchedConcepts = [];
      let missingConcepts = [];
      // Pencocokan kata utuh tanpa membuat RegExp dinamis untuk setiap konsep.
      const containsTerm = (term) => {
        const normalized = normalizeConcept(term);
        return normalized.length > 0 && userText.includes(' ' + normalized + ' ');
      };
      (Array.isArray(criteria.mandatoryConcepts) ? criteria.mandatoryConcepts : []).forEach((concept) => {
        const options = String(concept).split('/').map(x => x.trim()).filter(Boolean);
        const legacySynonyms = options.flatMap(option => criteria.synonyms?.[option] || []);
        const isPresent = [...options, ...legacySynonyms].some(containsTerm);
        if (isPresent) matchedConcepts.push(concept);
        else missingConcepts.push(concept);
      });

      const totalMandatory = Array.isArray(criteria.mandatoryConcepts) ? criteria.mandatoryConcepts.length : 0;
      const matchRatio = totalMandatory > 0 ? matchedConcepts.length / totalMandatory : 1;
      let calculatedScore = Math.round(matchRatio * 100);

      {
        const isPassed = calculatedScore >= criteria.minScore;
        let feedbackMsg = "";

        if (isPassed) {
          feedbackMsg = `Luar biasa! Jawabannmu telah mencakup konsep utama: (${matchedConcepts.join(', ')}). Kamu berhasil menunjukkan pemahaman konsep mandiri!`;
        } else {
          if (attemptCountForLevel === 0) {
            feedbackMsg = `Jawabanmu belum lengkap. Kamu belum menjelaskan konsep penting seperti: [${missingConcepts.join(', ')}]. Coba pelajari materi kembali!`;
          } else {
            feedbackMsg = `Hampir! Petunjuk: Pastikan kamu menyertakan kata kunci atau padanan dari ${missingConcepts.slice(0, 2).join(' dan ')}.`;
          }
        }

        evalResult = {
          score: calculatedScore,
          passed: isPassed,
          feedback: feedbackMsg,
          matchedConcepts,
          missingConcepts
        };

        // Simpan setiap percobaan agar guru dapat membaca jawaban asli murid.
        submissions.push({
          id: Date.now() + '-' + Math.random().toString(36).slice(2, 8),
          studentId: currentUser.id || 'S001',
          studentName: currentUser.name || 'Murid Demo',
          studentClass: currentUser.class || '-',
          levelId: activeLevel.id,
          levelTitle: activeLevel.title,
          question: activeLevel.question,
          answer: answerInputText.trim(),
          score: calculatedScore,
          passed: isPassed,
          matchedConcepts: [...matchedConcepts],
          missingConcepts: [...missingConcepts],
          feedback: feedbackMsg,
          submittedAt: new Date().toLocaleString('id-ID')
        });
        persistSubmissions();
        const studentRecord = students.find(st => st.id === (currentUser.id || 'S001'));
        if (studentRecord) {
          studentRecord.attemptsCount = (studentRecord.attemptsCount || 0) + 1;
          const passedLevels = new Set(submissions.filter(x => x.studentId === studentRecord.id && x.passed).map(x => x.levelId));
          studentRecord.progress = Math.round((passedLevels.size / Math.max(levels.length, 1)) * 100);
          studentRecord.currentLevel = Math.max(1, ...passedLevels);
        }
        attemptCountForLevel++;

        if (isPassed) {
          levels = levels.map(lvl => {
            if (lvl.id === activeLevel.id) return { ...lvl, status: 'completed' };
            if (lvl.id === activeLevel.id + 1 && lvl.status === 'locked') return { ...lvl, status: 'available' };
            return lvl;
          });
          // Status level murid dihitung dari riwayat jawaban, bukan disimpan sebagai perubahan soal guru.
        }

        renderView();
      }
      } catch (error) {
        console.error('Evaluasi konsep gagal:', error);
        showModalAlert('Pemeriksaan konsep mengalami kendala. Silakan coba lagi.');
        if (submitBtn && submitBtn.isConnected) {
          submitBtn.disabled = false;
          submitBtn.innerText = 'Kirim Jawaban Evaluasi';
        }
      } finally {
        isEvaluating = false;
      }
    }

