    // Simulasi animasi Array, Stack, Queue
     let arrayItems = [], stackItems = [], queueItems = [];
     let arrayCapacity = 0, selectedArrayIndex = 0;
     let simulationCounter = 1;
     const nextSimulationValue = () => String.fromCharCode(65 + ((simulationCounter++ - 1) % 26));
     function renderArrayItems() {
       if (!arrayCapacity) return '<span class="text-xs text-slate-400">Tentukan jumlah indeks untuk memulai.</span>';
       return arrayItems.map((v,i) => `<button type="button" onclick="selectArrayIndex(${i})" class="sim-item flex flex-col items-center gap-1 p-1.5 rounded-lg border-2 transition ${selectedArrayIndex===i?'border-violet-600 bg-violet-50':'border-transparent hover:border-violet-200'}" title="Pilih indeks ${i}"><span class="text-[10px] font-bold text-slate-500">[${i}]</span><span class="min-w-12 max-w-28 truncate px-3 py-2 rounded-md ${v===null?'bg-slate-50 border-dashed border-slate-300 text-slate-400':'bg-violet-100 border-violet-300 text-violet-900'} border text-xs font-bold">${v===null?'Kosong':escapeHTML(v)}</span></button>`).join('');
     }
     function setArrayCapacity() {
       const input=document.getElementById('array-capacity');
       const n=Number(input?.value);
       if(!Number.isInteger(n)||n<1||n>20) return simMessage('array-message','Jumlah indeks harus bilangan bulat antara 1 sampai 20.');
       if(arrayCapacity && arrayItems.some(v=>v!==null) && !confirm('Membuat array baru akan menghapus seluruh data array sebelumnya. Lanjutkan?')) return;
       arrayCapacity=n; arrayItems=Array(n).fill(null); selectedArrayIndex=0;
       refreshArrayUI(); simMessage('array-message',`Array dengan ${n} indeks dibuat. Pilih indeks 0–${n-1}, lalu masukkan data.`);
     }
     function selectArrayIndex(index) {
       const i=Number(index);
       if(!Number.isInteger(i)||i<0||i>=arrayCapacity) return;
       selectedArrayIndex=i;
       refreshArrayUI();
       const input=document.getElementById('array-value');
       if(input) {input.value=arrayItems[i]??''; input.focus();}
     }
     function refreshArrayUI(kind='update', index=selectedArrayIndex) {
       animateSimulation('array-visual',renderArrayItems(),kind,index);
       const select=document.getElementById('array-index');
       if(select){select.disabled=!arrayCapacity;select.innerHTML=arrayCapacity?arrayItems.map((v,i)=>`<option value="${i}" ${i===selectedArrayIndex?'selected':''}>Indeks ${i} — ${v===null?'Kosong':'Terisi'}</option>`).join(''):'<option value="">Buat array dahulu</option>';}
       const input=document.getElementById('array-value');if(input)input.disabled=!arrayCapacity;
       const exists=arrayCapacity>0 && arrayItems[selectedArrayIndex]!==null;
       for(const [id,enabled] of [['array-add-btn',arrayCapacity>0&&!exists],['array-edit-btn',exists],['array-delete-btn',exists]]) {const el=document.getElementById(id);if(el)el.disabled=!enabled;}
       const used=arrayItems.filter(v=>v!==null).length;
       const status=document.getElementById('array-status');
       if(status){status.textContent=arrayCapacity?(used===arrayCapacity?`INDEKS PENUH (FULL) — ${used}/${arrayCapacity} terisi`:`${used}/${arrayCapacity} indeks terisi • ${arrayCapacity-used} kosong`):'Belum ada array';status.className=`mt-3 text-xs font-bold ${arrayCapacity&&used===arrayCapacity?'text-rose-700':'text-violet-800'}`;}
     }
     function arrayInputValue(){return document.getElementById('array-value')?.value.trim()??'';}
    function renderStackItems() {
      return stackItems.length ? stackItems.map((v,i) => `<span class="sim-item w-28 text-center px-3 py-2 rounded-md bg-emerald-100 border border-emerald-300 text-emerald-900 text-xs font-bold">${escapeHTML(v)}${i === stackItems.length-1 ? ' ↑ PUNCAK' : ''}</span>`).join('') : '<span class="text-xs text-slate-400">Stack kosong</span>';
    }
    function renderQueueItems() {
      return queueItems.length ? '<span class="text-[10px] text-slate-500">DEPAN →</span>' + queueItems.map(v => `<span class="sim-item px-3 py-2 rounded-md bg-blue-100 border border-blue-300 text-blue-900 text-xs font-bold">${escapeHTML(v)}</span>`).join('') + '<span class="text-[10px] text-slate-500">← BELAKANG</span>' : '<span class="text-xs text-slate-400">Queue kosong</span>';
    }
    function animateSimulation(id, html, kind='add', index=-1) {
      const el = document.getElementById(id);
      if (!el) return;
      const before = new Map([...el.querySelectorAll('.sim-item')].map((node,i) => [i,node.getBoundingClientRect()]));
      el.innerHTML = html;
      const nodes = [...el.querySelectorAll('.sim-item')];
      nodes.forEach((node,i) => {
        const prev = before.get(i);
        const now = node.getBoundingClientRect();
        if (kind === 'add' && i === nodes.length-1) node.animate([{opacity:0,transform:'translateY(-28px) scale(.65)'},{opacity:1,transform:'translateY(0) scale(1)'}],{duration:550,easing:'cubic-bezier(.2,.8,.2,1)'});
        else if (kind === 'update' && i === index) node.animate([{backgroundColor:'#fef08a',transform:'scale(1.15)'},{backgroundColor:'transparent',transform:'scale(1)'}],{duration:650});
        else if (prev && kind === 'remove') node.animate([{transform:`translate(${prev.left-now.left}px, ${prev.top-now.top}px)`},{transform:'translate(0,0)'}],{duration:450,easing:'ease-out'});
      });
    }
    function updateSimulation(kind='add', index=-1) {
      animateSimulation('array-visual',renderArrayItems(),kind,index);
      animateSimulation('stack-visual',renderStackItems(),kind,index);
      animateSimulation('queue-visual',renderQueueItems(),kind,index);
    }
    function simMessage(id,text) { const el=document.getElementById(id); if(el) el.textContent=text; }
     function addArrayItem() {
       if(!arrayCapacity)return simMessage('array-message','Buat array terlebih dahulu.');
       const i=selectedArrayIndex, v=arrayInputValue();
       if(arrayItems[i]!==null)return simMessage('array-message',`Indeks [${i}] sudah terisi. Gunakan Edit Data.`);
       if(!v)return simMessage('array-message','Masukkan data terlebih dahulu.');
       arrayItems[i]=v;refreshArrayUI('update',i);
       simMessage('array-message',`Data "${v}" berhasil dimasukkan ke indeks [${i}].`);
     }
     function updateArrayItem() {
       const i=selectedArrayIndex,v=arrayInputValue();
       if(!arrayCapacity||arrayItems[i]===null)return simMessage('array-message','Pilih indeks yang sudah terisi untuk diedit.');
       if(!v)return simMessage('array-message','Data tidak boleh kosong. Gunakan Hapus Data untuk mengosongkan indeks.');
       const old=arrayItems[i];arrayItems[i]=v;refreshArrayUI('update',i);
       simMessage('array-message',`Indeks [${i}] diubah dari "${old}" menjadi "${v}".`);
     }
     function removeArrayItem() {
       const i=selectedArrayIndex;
       if(!arrayCapacity||arrayItems[i]===null)return simMessage('array-message','Pilih indeks yang sudah terisi untuk dihapus.');
       const old=arrayItems[i];arrayItems[i]=null;
       const input=document.getElementById('array-value');if(input)input.value='';
       refreshArrayUI('remove',i);simMessage('array-message',`Data "${old}" pada indeks [${i}] dihapus. Indeks tersebut kini kosong dan bisa diisi kembali.`);
     }
    function addStackItem() {
      if(stackItems.length>=6) return showModalAlert('Stack maksimal 6 elemen.');
      const v=nextSimulationValue(); stackItems.push(v); updateSimulation('add'); simMessage('stack-message',`Push ${v}: masuk ke puncak Stack (LIFO).`);
    }
    function removeStackItem() {
      const v=stackItems.pop(); updateSimulation('remove'); simMessage('stack-message',v?`Pop ${v}: elemen teratas keluar lebih dulu.`:'Stack kosong.');
    }
    function addQueueItem() {
      if(queueItems.length>=6) return showModalAlert('Queue maksimal 6 elemen.');
      const v=nextSimulationValue(); queueItems.push(v); updateSimulation('add'); simMessage('queue-message',`Enqueue ${v}: masuk dari belakang antrean.`);
    }
    function removeQueueItem() {
      const v=queueItems.shift(); updateSimulation('remove'); simMessage('queue-message',v?`Dequeue ${v}: elemen terdepan keluar lebih dulu (FIFO).`:'Queue kosong.');
    }
    function resetSimulation() {
      arrayItems=[]; stackItems=[]; queueItems=[]; simulationCounter=1;
      updateSimulation('remove');
      ['array-message','stack-message','queue-message'].forEach(id=>simMessage(id,'Simulasi direset. Tambahkan data untuk memulai.'));
